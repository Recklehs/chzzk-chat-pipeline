API_KEY=change-me
SESSION_SECRET_KEY=change-me-too

# `PUBSUB_PROJECT_ID` falls back to `GOOGLE_CLOUD_PROJECT` when omitted.
PUBSUB_PROJECT_ID=your-gcp-project
PUBSUB_RAW_TOPIC=chzzk-events-raw

KAFKA_BOOTSTRAP_SERVERS=your-kafka-bootstrap:9092
KAFKA_TOPIC=chzzk.events.raw
KAFKA_CLIENT_ID=chzzk-collector
KAFKA_PRODUCER_LINGER_MS=0
KAFKA_PRODUCER_MAX_BATCH_SIZE=65536
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4

# macOS에서 Pub/Sub gRPC DNS 해석 이슈가 있으면 아래 값을 사용하세요.
# GRPC_DNS_RESOLVER=native

COLLECTOR_INSTANCE_ID=collector-prod
CHZZK_API_BASE_URL=https://api.chzzk.naver.com
CHZZK_API_TIMEOUT_SECONDS=10
CHZZK_LIVE_POLL_SECONDS=15
CHZZK_LIVE_POLL_MAX_SECONDS=60
CONTROL_DB_PATH=data/control.db
DASHBOARD_REFRESH_SECONDS=5
METRICS_ENABLED=false

# Optional ADC setting when not using `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
